{
  "name": "subadapp",
  "main": "node_modules/expo/AppEntry.js",
  "license": "Apache-2.0",
  "version": "0.28.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/subadapcocuk/subadapp.git"
  },
  "bugs": {
    "url": "https://github.com/subadapcocuk/subadapp/issues",
    "email": "subadapcocuk+subadapp@gmail.com"
  },
  "funding": {
    "type": "Şubadap Çocuk Kreosus",
    "url": "https://www.kreosus.com/subadapcocuk"
  },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "start": "expo start",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "fix": "expo install --fix",
    "doctor": "expo doctor",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:android": "eas build --platform android --profile production",
    "build:android:local": "eas build --platform android --profile production --local",
    "build:android:development": "eas build --platform android --profile development",
    "build:android:development:local": "eas build --platform android --profile development --local",
    "build:apk": "eas build --platform android --profile preview",
    "build:ios": "eas build --platform ios --non-interactive",
    "build:all": "eas build --platform all --non-interactive",
    "submit:android": "eas submit --platform android",
    "submit:ios": "eas submit --platform ios",
    "release": "commit-and-tag-version --release-as ",
    "eject": "expo eject"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.17",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.0",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/drawer": "^7.14.4",
    "@react-navigation/native": "^7.5.1",
    "expo": "~57.0.31",
    "expo-asset": "^57.0.20",
    "expo-audio": "^57.0.5",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.22",
    "expo-device": "~57.0.2",
    "expo-file-system": "^57.0.7",
    "expo-font": "^57.0.4",
    "expo-linking": "~57.0.13",
    "expo-splash-screen": "^57.0.10",
    "expo-status-bar": "~57.0.1",
    "lodash": "^4.18.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-pager-view": "8.0.2",
    "react-native-reanimated": "~4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-toast-message": "^2.5.2",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "^0.10.1"
  },
  "devDependencies": {
    "babel-preset-expo": "^57.0.16",
    "commit-and-tag-version": "^13.3.0",
    "expo-dev-client": "~57.0.20"
  }
